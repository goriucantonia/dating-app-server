# server submodule ignores — the superproject root's .gitignore does not reach
# in here (and this one does not cover the root).
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/

# Probe run output redirected from a shell (e.g. `> match_out.txt`). Scratch,
# never a source file — and D-009 is the story of two probe runs sharing one.
match_out.txt
